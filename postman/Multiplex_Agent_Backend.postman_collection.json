    {
      "name": "6. Subscription - Payments",
      "description": "Base: `/api/v1/subscription`. CARD=Stripe Checkout (metadata subscriptionId+paymentId), BKASH=tokenized payment URL (Payment PENDING + DRAFT). Webhook/callback activate subscription, upgrade plan, PDF invoice + mail.",
      "item": [
        {
          "name": "POST Create Subscription - CARD (Stripe)",
          "request": {
            "description": "USER only. Creates Stripe Checkout Session. Returns session URL — open in browser to pay. billingCycle: MONTHLY | HALF_YEARLY | YEARLY.",
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"CARD\",\n  \"billingCycle\": \"MONTHLY\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/subscription",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "subscription"]
            }
          },
          "response": []
        },
        {
          "name": "POST Create Subscription - BKASH",
          "request": {
            "description": "USER only. Returns bKash payment URL — open in browser to pay. Verifies/executes via GET /bkash/callback, then activates subscription. Other cycles: HALF_YEARLY, YEARLY.",
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"BKASH\",\n  \"billingCycle\": \"MONTHLY\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
