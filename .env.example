# Multiplex Agent Backend — Example Environment Variables
# Copy to .env:  cp .env.example .env  (Windows: copy .env.example .env)
# Never commit real secrets. .env is gitignored.

# ---------- Runtime ----------
NODE_ENV=development
PORT=5000
APP_NAME=multiplex-agent-backend
SWAGGER_ENABLE=true

# ---------- Database (PostgreSQL via Prisma) ----------
DATABASE_URL=postgresql://user:password@localhost:5432/multiplex_db?schema=public

# ---------- URLs ----------
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ---------- Auth / Security ----------
BCRYPT_SALT_ROUNDS=10
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Redis (note: RADIS spelling required by src/app/config/index.ts) ----------
RADIS_NAME=default
RADIS_PASSWORD=change-me
RADIS_HOST=localhost
RADIS_PORT=6379

# ---------- Email (Gmail + Nodemailer + EJS) ----------
SMTP_USER=you@gmail.com
SMTP_SENDER=you@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# ---------- Cloudinary (profile images) ----------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---------- Seed tester admin (created on boot in src/main.ts) ----------
TESTER_ADMIN_NAME=Test Admin
TESTER_ADMIN_EMAIL=admin@example.com
TESTER_ADMIN_PASSWORD=Admin@12345

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URI=http://localhost:5000/api/v1/auth/google/callback

# ---------- GitHub OAuth ----------
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# ---------- AI (Groq) + Encryption ----------
GROQ_API_KEY=gsk_your-groq-api-key
ENCRYPTION_KEY=your-32-byte-encryption-key-for-AES-256-GCM

# ---------- bKash (tokenized checkout) ----------
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/subscription/bkash/callback

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
